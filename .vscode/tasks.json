{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "(MetaHub) PostgreSQL",
			"type": "shell",
			"problemMatcher": [],
			"command": [
				"cd mh-backend",
				"&&",
				"podman run -it --rm --name mh_postgres",
				"-e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=metahub -p 5433:5432",
				"-v ./metahub/db/:/docker-entrypoint-initdb.d/",
				"docker.io/library/postgres"
			],
		},
		{
			"label": "(MetaHub) backend",
			"type": "shell",
			"problemMatcher": "$python",
			"options": {
				"env": {
					"POSTGRES_PORT": "5433",
				}
			},
			"command": [
				"cd mh-backend",
				"&&",
				"until pg_isready -h localhost -p 5433; do echo 'Waiting for Postgres...'; sleep 1; done",
				"&&",
				"uv run uvicorn --reload --port=8033 metahub.main:app"
			]
		},
		{
			"label": "(MetaHub) frontend",
			"type": "shell",
			"problemMatcher": "$tsc",
			"options": {
				"env": {
					"VITE_API_PORT": "8033"
				}
			},
			"command": [
				"cd mh-frontend",
				"&&",
				"until /bin/nc -z localhost 8033; do sleep 1; done",
				"&&",
				"pnpm run dev --port 5133 --open",
			]
		},
		{
			"label": "🚀 MetaHub",
			"dependsOrder": "parallel",
			"dependsOn": [
				"(MetaHub) PostgreSQL",
				"(MetaHub) backend",
				"(MetaHub) frontend",
			],
			"group": "build"
		},
		{
			"label": "(TClient) PostgreSQL",
			"type": "shell",
			"problemMatcher": [],
			"command": [
				"cd tc-backend",
				"&&",
				"podman run -it --rm --name tc_postgres",
				"-e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=tc -p 5430:5432",
				"-v ./tc/db/:/docker-entrypoint-initdb.d/",
				"docker.io/library/postgres"
			],
		},
		{
			"label": "(TClient) backend",
			"type": "shell",
			"problemMatcher": "$python",
			"options": {
				"env": {
					"POSTGRES_PORT": "5430",
					"KEYCLOAK_URL": "http://localhost:8080",
					"KEYCLOAK_URL_PUBLIC": "http://localhost:8080",
					"KEYCLOAK_REALM": "master",
					"KEYCLOAK_CLIENT_ID": "miz",
				}
			},
			"command": [
				"cd tc-backend",
				"&&",
				"until pg_isready -h localhost -p 5430; do echo 'Waiting for Postgres...'; sleep 1; done",
				"&&",
				"uv run uvicorn --reload --port=8030 tc.main:app"
			]
		},
		{
			"label": "(TClient) frontend",
			"type": "shell",
			"problemMatcher": "$tsc",
			"options": {
				"env": {
					"VITE_API_PORT": "8030"
				}
			},
			"command": [
				"cd tc-frontend",
				"&&",
				"until /bin/nc -z localhost 8030; do sleep 1; done",
				"&&",
				"pnpm run dev --port 5130 --open",
			]
		},
		{
			"label": "🚀 TClient",
			"dependsOrder": "parallel",
			"dependsOn": [
				"(TClient) PostgreSQL",
				"(TClient) backend",
				"(TClient) frontend",
			],
			"group": "build"
		},
		{
			"label": "🚀 Full MHC",
			"dependsOrder": "parallel",
			"dependsOn": [
				"(MetaHub) PostgreSQL",
				"(MetaHub) backend",
				"(MetaHub) frontend",
				"(TClient) PostgreSQL",
				"(TClient) backend",
				"(TClient) frontend",
			],
			"group": "build"
		}
	]
}